# Copy this file to keystore.properties (same folder) and fill in your own upload key.
# keystore.properties is git-ignored and must never be committed or shared.
#
# Create the key once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias twoaccmess \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# With this file present, `./gradlew :app:assembleRelease` produces a signed, shrunk, store-ready APK
# under app/build/outputs/apk/release/. Without it the release build still assembles, unsigned.

storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=twoaccmess
keyPassword=change-me