*.iml
.gradle
/local.properties
# Android Studio's own project state: kept on disk, never tracked again.
.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Release signing secrets and the keystore itself: never committed.
keystore.properties
*.jks
*.keystore

# Agent run logs kept for evidence; not part of the project.
.freebuff/

# Bop Desktop: the Electron binary and npm tree are reinstalled with `npm install`.
desktop/node_modules/
desktop/dist/
# The portable build the prepackaged config writes, and its unpacked staging tree.
desktop/dist-portable-final/

# Bop Desktop: throwaway browser profiles and release smoke evidence, local only.
desktop/tmp/

# Python bytecode from the bubble-waitroom harness.
__pycache__/

# JVM replay log written by Android Studio runs.
replay_pid*.log

# Harness output written by the verification runs.
desktop/dist-smoke/
desktop/dist-retry/
desktop/retry-run.log
desktop/smoke-run.log

# The standalone notifier fixture is a tool; only its sources belong in the repository.
tools/notifier-fixture/build/
tools/notifier-fixture/.gradle/
tools/notifier-fixture/local.properties
