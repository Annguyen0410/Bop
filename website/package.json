{
  "name": "bop-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bop's product site: a static, dependency-free page with a zero-dependency build and browser checks.",
  "scripts": {
    "dev": "node scripts/serve.mjs --dir . --port 4173",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dir dist --port 4173",
    "test": "node --test test/",
    "check:browser": "node scripts/build.mjs && node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
